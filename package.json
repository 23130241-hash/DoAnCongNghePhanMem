{
    "name": "kingdom-defense",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win --x64",
        "test": "jest --ci --reporters=default --reporters=jest-junit"
    },
    "devDependencies": {
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-junit": "^16.0.0"
    },
    "jest-junit": {
        "outputDirectory": "test-results",
        "outputName": "junit.xml"
    },
    "build": {
        "appId": "com.yourname.kingdomdefense",
        "productName": "KingdomDefense",
        "files": [
            "index.html",
            "main.js",
            "css/style.css",
            "src/core/config.js",
            "src/core/game.js",
            "src/managers/wave_manager.js",
            "src/managers/base_collision.js",
            "src/managers/campaign.js",
            "src/managers/combo_damge.js",
            "src/managers/upgrade_system.js"
        ],
        "win": {
            "target": "portable",
            "signAndEditExecutable": false,
            "signingHashAlgorithms": null
        }
    }
}
