{
    "name": "kingdom-defense",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win --x64"
    },
    "devDependencies": {
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.yourname.kingdomdefense",
        "productName": "KingdomDefense",
        "files": [
            "index.html", "style.css", "config.js",
            "game.js", "main.js"
        ],
        "win": {
            "target": "portable",
            "signAndEditExecutable": false,
            "signingHashAlgorithms": null
        }
    }
}
